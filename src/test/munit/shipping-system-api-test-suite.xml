    <munit:test name="shipping-dispatch-rejected-test" description="Verifies unserviceable location produces business failure">
        <munit:behavior>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['Check processed commands']" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:variables>
                        <munit-tools:variable key="existingDispatch" value="#[[]]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="db:insert">
                <munit-tools:then-return>
                    <munit-tools:payload value="#[{ affectedRows: 1 }]" />
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:variables>
                    <munit:variable key="command" value='#[{ correlationId: "c1", sagaId: "SAGA-01-REJ", stepId: "S-03-REJ", stepName: "DISPATCH_SHIPPING", commandType: "DISPATCH", attempt: 1, payload: { orderId: "ORD-01", postalCode: "000000", serviceLevel: "FAIL_DISPATCH", addressLine1: "REJECT Bad Address", city: "Nowhere", state: "NA", country: "India" } }]' />
                    <munit:variable key="dedupKey" value="#['SAGA-01-REJ:S-03-REJ:DISPATCH']" />
                </munit:variables>
            </munit:set-event>
            <flow-ref name="shipping-dispatch-Sub_Flow" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-equals actual="#[vars.shippingReply.outcome]" expected="#['FAILURE']" message="Outcome should be FAILURE" />
            <munit-tools:assert-equals actual="#[vars.shippingReply.retryable]" expected="#[false]" message="Address error should not be retryable" />
        </munit:validation>
    </munit:test>

    <!-- 3. Shipping Dispatch: Idempotent Replay -->
    <munit:test name="shipping-dispatch-idempotent-replay-test" description="Verifies cached response returned on duplicate dispatch command">
        <munit:behavior>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['Check processed commands']" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:variables>
                        <munit-tools:variable key="existingDispatch" value="#[[{ dedup_key: 'SAGA-01:S-03:DISPATCH', result_payload: '{ &quot;outcome&quot;: &quot;SUCCESS&quot;, &quot;trackingNumber&quot;: &quot;TRK-CACHED-77&quot; }' }]]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:variables>
                    <munit:variable key="command" value='#[{ correlationId: "c1", sagaId: "SAGA-01", stepId: "S-03", stepName: "DISPATCH_SHIPPING", commandType: "DISPATCH", attempt: 1, payload: { orderId: "ORD-01", shippingAddress: { addressLine1: "21 Anna Salai", postalCode: "600002" } } }]' />
                    <munit:variable key="dedupKey" value="#['SAGA-01:S-03:DISPATCH']" />
                </munit:variables>
            </munit:set-event>
            <flow-ref name="shipping-dispatch-Sub_Flow" />
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-equals actual="#[vars.shippingReply.trackingNumber]" expected="#['TRK-CACHED-77']" message="Replayed trackingNumber should match cached record" />
        </munit:validation>
    </munit:test>

