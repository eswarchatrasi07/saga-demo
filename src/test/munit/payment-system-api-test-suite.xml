    <!-- 13. Duplicate Race Subflow: Winner Available -->
    <munit:test name="payment-duplicate-race-winner-available-test" description="Verifies duplicate race handles existing winner response">
        <munit:behavior>
            <munit-tools:mock-when processor="db:select">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="#['Read winner response']" />
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:variables>
                        <munit-tools:variable key="raceCheckResult" value="#[[{ result_payload: '{ &quot;outcome&quot;: &quot;SUCCESS&quot;, &quot;paymentId&quot;: &quot;PAY-RACE-01&quot; }' }]]" />
                    </munit-tools:variables>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event>
                <munit:variables>
                    <munit:variable key="dedupKey" value="#['DEDUP-RACE-01']" />
                </munit:variables>
            </munit:set-event>
            <try>
                <raise-error type="APP:DUPLICATE" description="Duplicate entry 'DEDUP-RACE-01' for key PRIMARY" />
                <error-handler>
                    <on-error-continue>
                        <flow-ref name="payment-handle-duplicate-race-sub-flow" />
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-equals actual="#[vars.httpStatus as Number default 200]" expected="#[200]" message="Status should be 200" />
            <munit-tools:assert-equals actual="#[payload.outcome]" expected="#['SUCCESS']" message="Outcome should be SUCCESS" />
        </munit:validation>
    </munit:test>

