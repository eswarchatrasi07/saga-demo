<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core"
      xmlns:http="http://www.mulesoft.org/schema/mule/http"
      xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit"
      xmlns="http://www.mulesoft.org/schema/mule/core"
      xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="
        http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
        http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd
        http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd
        http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd">

    <apikit:config name="order-experience-api-config" 
                   api="api/order-experience-api.raml" 
                   outboundHeadersMapName="outboundHeaders" 
                   httpStatusVarName="httpStatus" 
                   doc:name="APIKit Config" />

    <flow name="order-experience-api-main">
        <http:listener config-ref="Shared_HTTP_Listener_config" path="/api/v1/*" doc:name="Listener (Port 8081)">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:router config-ref="order-experience-api-config" doc:name="APIKit Router" />
        <error-handler ref="global-error-handler" />
    </flow>

    <flow name="order-experience-api-console">
        <http:listener config-ref="Shared_HTTP_Listener_config" path="/console/*" doc:name="Console Listener">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body>#[payload]</http:body>
                <http:headers>#[vars.outboundHeaders default {}]</http:headers>
            </http:error-response>
        </http:listener>
        <apikit:console config-ref="order-experience-api-config" doc:name="APIKit Console" />
        <error-handler ref="global-error-handler" />
    </flow>

    <flow name="post:\sagas\order-fulfilment:application\json:order-experience-api-config">
        <set-variable variableName="corrId" 
                      value="#[attributes.headers['x-correlation-id'] default attributes.headers['correlationid'] default correlationId default uuid()]" 
                      doc:name="Resolve Correlation ID" />
        <set-variable variableName="inboundReq" 
                      value="#[payload]" 
                      doc:name="Save Incoming Order Payload" />

        <logger level="INFO" 
                doc:name="Log Experience Inbound Request" 
                message="#[output text/plain --- '[EXP-API] Inbound order-fulfilment received: orderId=' ++ (vars.inboundReq.orderId default 'UNKNOWN' as String) ++ ' | correlationId=' ++ (vars.corrId default '' as String)]" />

        <flow-ref name="saga-process-order-fulfilment" doc:name="Invoke Saga Orchestrator" />

        <set-variable variableName="outboundHeaders" 
                      value="#[output application/java --- { 'X-Correlation-ID': vars.corrId }]" 
                      doc:name="Set Outbound Correlation Header" />
    </flow>

    <flow name="get:\sagas\(sagaId):order-experience-api-config">
        <set-variable variableName="lookupSagaId" 
                      value="#[attributes.uriParams.sagaId]" 
                      doc:name="Extract sagaId from URI" />
        <set-variable variableName="corrId" 
                      value="#[attributes.headers['x-correlation-id'] default attributes.headers['correlationid'] default correlationId default uuid()]" 
                      doc:name="Resolve Correlation ID" />

        <logger level="INFO" 
                doc:name="Log Experience Status Query" 
                message="#[output text/plain --- '[EXP-API] Saga query for sagaId=' ++ (vars.lookupSagaId default '' as String) ++ ' | correlationId=' ++ (vars.corrId default '' as String)]" />

        <flow-ref name="saga-process-get-status" doc:name="Query Saga Status" />

        <set-variable variableName="outboundHeaders" 
                      value="#[output application/java --- { 'X-Correlation-ID': vars.corrId }]" 
                      doc:name="Set Outbound Correlation Header" />
    </flow>

</mule>